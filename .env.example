# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env depoya girmez.

# Yönetim paneli (/yonetim) şifresi. Panelden değiştirilirse bu değer artık kullanılmaz.
ADMIN_SIFRE=

# Jürilerin ortak giriş şifresi (isteğe bağlı; panelden de belirlenebilir).
JURI_SIFRE=

# İsteğe bağlı
# PORT=3100
# HOST=0.0.0.0
# DATA_DIR=.            # egitijam.db ve urunler/ klasörü burada tutulur
# TRUST_PROXY=false     # ters vekil arkasında true (X-Forwarded-For okunur)
# OYUN_MB=300           # tarayıcı oyunu ZIP'i için üst sınır (MB)
# INDIRME_MB=500        # indirilebilir dosya için üst sınır (MB)
# EK_MB=10              # mesajlara eklenen her dosya için üst sınır (MB)
# OYUN_ADRESI=          # oyunlar ayrı bir alan adından sunulacaksa, ör. https://oyun.ornek.gov.tr (bkz. README)
